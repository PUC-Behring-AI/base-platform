{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["auth"],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"}
      }
    },
    "auth": {
      "type": "object",
      "required": ["existingSecret", "username", "database"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1, "description": "auth.existingSecret"},
        "username": {"type": "string", "minLength": 1},
        "database": {"type": "string", "minLength": 1},
        "passwordKey": {"type": "string", "minLength": 1}
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "className": {"type": "string", "minLength": 1},
        "size": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "pattern": "^/"}
      }
    },
    "allowFrom": {"type": "array", "items": {"type": "object"}}
  }
}
