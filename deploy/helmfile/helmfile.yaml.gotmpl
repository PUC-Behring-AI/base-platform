# The whole base as Helm releases, for scripts/k8s-up.sh on kind and for an
# instance's own install on the managed cluster (ADAPTATION §10).
#
# This file holds what every deployment shares: which releases exist, in
# which namespace, in which order, and how they are wired to each other (the
# database each layer uses, the Secret it reads, the Gateway it attaches to).
# What one deployment decides (images, models, origins, sizes) comes from the
# instance directory: values/common/<release>.yaml, then
# values/<environment>/<release>.yaml, both required for each layer release
# (an empty file is fine).
#
# Two environments:
#   kind  the local cluster k8s-up.sh makes, which applies the edge Gateway
#         and the StorageClass itself (deploy/kind/)
#   eks   the managed cluster (deploy/terraform/cluster), which makes the
#         StorageClass; the edge Gateway is release edge/gateway here, of
#         GatewayClass `gatewayClass` (default base-alb, the module's output
#         gateway_class; --state-values-set gatewayClass=<name> for another).
#         After values/eks/<release>.yaml, each layer release also takes
#         <instance>/eks/.generated/<release>.yaml when that file exists: the
#         instance's images pinned by digest, written by its push step.
#
# Read from the environment, which k8s-up.sh sets on kind:
#   BASE_ROOT          the directory that holds the base-* checkouts
#   K8S_INSTANCE_DIR   the instance directory
#   KIND_NETWORK_CIDR  the kind docker network, where the Gateway's proxy runs
#                      (kind only)
#
# Order (`needs`): inference-db -> inference -> knowledge -> agents ->
# interface, each after its namespace's schemas; interface also after its
# account store, which its migration hook needs before anything else starts.
#
# An instance adds releases of its own in <instance>/releases.yaml (a store a
# layer of its own needs, say), each from a base chart on the allow-list
# below, after its namespace's schemas, and before every layer that names it
# in `neededBy`:
#
#   releases:
#     - name: knowledge-store
#       namespace: knowledge
#       chart: postgres                 # one of the allow-list
#       values: [values/common/knowledge-store.yaml]   # relative to the instance
#       needs: []                       # optional, as helmfile: <namespace>/<name>
#       neededBy: [knowledge]           # optional: layers installed after it
#
# Anything else in the file, or a chart off the list, is refused.

environments:
  kind: {}
  eks:
    values:
      - gatewayClass: base-alb
---
{{- $base := requiredEnv "BASE_ROOT" }}
{{- $instance := requiredEnv "K8S_INSTANCE_DIR" }}
{{- $env := .Environment.Name }}
{{- $layers := list "interface" "agents" "knowledge" "inference" }}
{{- $namespaces := list "interface" "agents" "knowledge" "inference" "edge" }}
{{- $charts := dict "postgres" "../charts/postgres" }}
{{- $baseReleases := list "schemas" "interface-accounts-db" "inference-db" "inference" "knowledge" "agents" "interface" }}
{{- $fields := list "name" "namespace" "chart" "values" "needs" "neededBy" }}
{{- $extra := list }}
{{- $overlay := dict }}
{{- if eq $env "eks" }}
{{- range $layers }}
{{- $file := printf "%s/eks/.generated/%s.yaml" $instance . }}
{{- if isFile $file }}{{ $_ := set $overlay . $file }}{{ end }}
{{- end }}
{{- end }}
{{- $releasesFile := printf "%s/releases.yaml" $instance }}
{{- if isFile $releasesFile }}
{{- $doc := readFile $releasesFile | fromYaml }}
{{- range $key, $_ := $doc }}
{{- if ne $key "releases" }}{{ fail (printf "%s: unknown key %q (only: releases)" $releasesFile $key) }}{{ end }}
{{- end }}
{{- $extra = index $doc "releases" | default list }}
{{- if not (kindIs "slice" $extra) }}{{ fail (printf "%s: releases is not a list" $releasesFile) }}{{ end }}
{{- end }}
{{- $seen := list }}
{{- $neededBy := dict "interface" list "agents" list "knowledge" list "inference" list }}
{{- range $extra }}
{{- $r := . }}
{{- if not (kindIs "map" $r) }}{{ fail (printf "%s: a release is not a mapping: %v" $releasesFile $r) }}{{ end }}
{{- range $key, $_ := $r }}
{{- if not (has $key $fields) }}{{ fail (printf "%s: release %v: unknown key %q (one of: %s)" $releasesFile (index $r "name") $key (join ", " $fields)) }}{{ end }}
{{- end }}
{{- if not (index $r "name") }}{{ fail (printf "%s: a release has no name" $releasesFile) }}{{ end }}
{{- if not (regexMatch "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" (toString $r.name)) }}{{ fail (printf "%s: release name %q is not a DNS label (lower case, digits, -)" $releasesFile (toString $r.name)) }}{{ end }}
{{- if has $r.name $seen }}{{ fail (printf "%s: release %s is listed twice" $releasesFile $r.name) }}{{ end }}
{{- $seen = append $seen $r.name }}
{{- range list "values" "needs" "neededBy" }}
{{- if and (hasKey $r .) (not (kindIs "slice" (index $r .))) }}{{ fail (printf "%s: release %s: %s is not a list" $releasesFile $r.name .) }}{{ end }}
{{- end }}
{{- if has $r.name $baseReleases }}{{ fail (printf "%s: release %s: the base already has a release by that name" $releasesFile $r.name) }}{{ end }}
{{- if not (has (index $r "namespace") $namespaces) }}{{ fail (printf "%s: release %s: namespace %q is not one of: %s" $releasesFile $r.name (index $r "namespace") (join ", " $namespaces)) }}{{ end }}
{{- if not (hasKey $charts (index $r "chart" | toString)) }}{{ fail (printf "%s: release %s: chart %q is not one of the base charts an instance may use: %s" $releasesFile $r.name (index $r "chart") (keys $charts | sortAlpha | join ", ")) }}{{ end }}
{{- range index $r "values" | default list }}
{{- if not (isFile (printf "%s/%s" $instance .)) }}{{ fail (printf "%s: release %s: no values file %s/%s" $releasesFile $r.name $instance .) }}{{ end }}
{{- end }}
{{- range index $r "needs" | default list }}
{{- if not (regexMatch "^[a-z0-9-]+/[a-z0-9-]+$" (toString .)) }}{{ fail (printf "%s: release %s: needs %q is not <namespace>/<release>" $releasesFile $r.name (toString .)) }}{{ end }}
{{- end }}
{{- range index $r "neededBy" | default list }}
{{- if not (has . $layers) }}{{ fail (printf "%s: release %s: neededBy %q is not a layer (one of: %s)" $releasesFile $r.name . (join ", " $layers)) }}{{ end }}
{{- $_ := set $neededBy . (append (index $neededBy .) (printf "%s/%s" $r.namespace $r.name)) }}
{{- end }}
{{- end }}

helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  createNamespace: false

releases:
{{- range $layers }}
  - name: schemas
    namespace: {{ . }}
    chart: ../charts/schemas
{{- end }}

  - name: interface-accounts-db
    namespace: interface
    chart: ../charts/postgres
    needs: [interface/schemas]
    values:
      - auth:
          username: interface_owner
          database: interface_owner
          existingSecret: k8s-secrets
          passwordKey: ACCOUNTS_DB_OWNER_PASSWORD
        allowFrom:
          - podSelector:
              matchExpressions:
                - {key: app.kubernetes.io/name, operator: In, values: [base-interface]}
                - {key: app.kubernetes.io/instance, operator: In, values: [interface]}
                - {key: app.kubernetes.io/component, operator: In, values: [identity-sidecar, accounts-migrate, bff]}

  - name: inference-db
    namespace: inference
    chart: ../charts/postgres
    needs: [inference/schemas]
    values:
      - auth:
          username: litellm
          database: litellm
          existingSecret: k8s-secrets
          passwordKey: POSTGRES_PASSWORD
        allowFrom:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: base-inference
                app.kubernetes.io/instance: inference
                app.kubernetes.io/component: litellm

  - name: inference
    namespace: inference
    chart: {{ $base }}/base-inference/deploy/chart
    needs: [inference/inference-db{{ range index $neededBy "inference" }}, {{ . }}{{ end }}]
    values:
      - secrets:
          existingSecret: k8s-secrets
        database:
          host: inference-db
      - {{ $instance }}/values/common/inference.yaml
      - {{ $instance }}/values/{{ $env }}/inference.yaml
{{- with index $overlay "inference" }}
      - {{ . }}
{{- end }}

  - name: knowledge
    namespace: knowledge
    chart: {{ $base }}/base-knowledge/deploy/chart
    needs: [knowledge/schemas, inference/inference{{ range index $neededBy "knowledge" }}, {{ . }}{{ end }}]
    values:
      - {{ $instance }}/values/common/knowledge.yaml
      - {{ $instance }}/values/{{ $env }}/knowledge.yaml
{{- with index $overlay "knowledge" }}
      - {{ . }}
{{- end }}

  - name: agents
    namespace: agents
    chart: {{ $base }}/base-agents/deploy/chart
    needs: [agents/schemas, knowledge/knowledge{{ range index $neededBy "agents" }}, {{ . }}{{ end }}]
    values:
      - {{ $instance }}/values/common/agents.yaml
      - {{ $instance }}/values/{{ $env }}/agents.yaml
{{- with index $overlay "agents" }}
      - {{ . }}
{{- end }}

  - name: interface
    namespace: interface
    chart: {{ $base }}/base-interface/deploy/chart
    needs: [interface/interface-accounts-db, agents/agents{{ if eq $env "eks" }}, edge/gateway{{ end }}{{ range index $neededBy "interface" }}, {{ . }}{{ end }}]
    values:
      - secrets:
          existingSecret: k8s-secrets
        accountsDb:
          host: interface-accounts-db
        gateway:
          parentRef: {name: base, namespace: edge, sectionName: http}
{{- if eq $env "kind" }}
        edge:
          # The Gateway's proxy is a container on the kind network, outside
          # the cluster; its traffic reaches the edge from that subnet.
          allowFrom:
            - ipBlock:
                cidr: {{ requiredEnv "KIND_NETWORK_CIDR" }}
{{- end }}
      - {{ $instance }}/values/common/interface.yaml
      - {{ $instance }}/values/{{ $env }}/interface.yaml
{{- with index $overlay "interface" }}
      - {{ . }}
{{- end }}
{{- if eq $env "eks" }}

  - name: gateway
    namespace: edge
    chart: ../charts/gateway
    values:
      - className: {{ .Values.gatewayClass }}
{{- end }}
{{- range $extra }}

  - name: {{ .name }}
    namespace: {{ .namespace }}
    chart: {{ index $charts .chart }}
    needs: [{{ .namespace }}/schemas{{ range index . "needs" | default list }}, {{ . }}{{ end }}]
    values:
{{- range index . "values" | default list }}
      - {{ $instance }}/{{ . }}
{{- end }}
{{- end }}
