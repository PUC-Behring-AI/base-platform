# The reference instance's secrets. Copy to .env (git-ignored) and fill every
# line; scripts/k8s-up.sh refuses an empty one. Throwaway values are fine for
# a local cluster, e.g. `openssl rand -hex 24` for each.
#
# Which Secret gets each key is .env.required's second column: every key
# below lands in Secret k8s-secrets of the namespace named in its section,
# and the charts read it from there by `existingSecret: k8s-secrets`.

# namespace interface — the interface chart (secrets.existingSecret) and the
# account store release interface-accounts-db (auth.passwordKey
# ACCOUNTS_DB_OWNER_PASSWORD).
ACCOUNTS_DB_OWNER_PASSWORD=
ACCOUNTS_DB_BFF_PASSWORD=
ACCOUNTS_DB_C5_PASSWORD=
C5_OPERATOR_TOKEN=

# namespace inference — the inference chart (secrets.existingSecret) and the
# gateway's store release inference-db (auth.passwordKey POSTGRES_PASSWORD).
# POSTGRES_PASSWORD goes into a URL unescaped: hex only.
LITELLM_MASTER_KEY=
UI_PASSWORD=
POSTGRES_PASSWORD=
STAND_IN_KEY=

# namespaces knowledge and agents need none here: no embedding model, and
# agents runs its fake inference.
