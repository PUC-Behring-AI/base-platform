{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.base.internal/c8_record.schema.json",
  "title": "C8 — domain records",
  "description": "agents -> knowledge. Writes and reads of the records a person builds through the product (an instance defines what a record is), and uploads of sources for ingestion. The body of a record is instance-defined; the collection names are declared by the instance in knowledge. The engine, never the caller, stamps the classification, from the collection's declaration. Every write emits a C6 record under the request id it carries.",
  "$defs": {
    "collection": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "A collection the instance declared in knowledge. An undeclared collection is refused."
    },
    "write_request": {
      "type": "object",
      "description": "Create (no record_id) or replace (record_id plus expected_revision). requested_class may only make the record more sensitive than its collection's class, never less; the engine refuses a lower one.",
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "collection": { "$ref": "#/$defs/collection" },
        "record_id": { "type": "string", "minLength": 1 },
        "expected_revision": { "type": "integer", "minimum": 1 },
        "requested_class": { "type": "string", "minLength": 1 },
        "body": { "type": "object" }
      },
      "required": ["request_id", "collection", "body"],
      "dependentRequired": { "record_id": ["expected_revision"], "expected_revision": ["record_id"] },
      "additionalProperties": false
    },
    "write_response": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "record_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "classification": { "$ref": "https://schemas.base.internal/classification.schema.json" }
      },
      "required": ["request_id", "record_id", "revision", "classification"],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "description": "A record as read back. There is no read path without a classification, as on C1.",
      "properties": {
        "collection": { "$ref": "#/$defs/collection" },
        "record_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "updated_at": { "type": "string", "format": "date-time" },
        "classification": { "$ref": "https://schemas.base.internal/classification.schema.json" },
        "body": { "type": "object" }
      },
      "required": ["collection", "record_id", "revision", "updated_at", "classification", "body"],
      "additionalProperties": false
    },
    "read_response": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "next_cursor": { "type": "string" }
      },
      "required": ["request_id", "records"],
      "additionalProperties": false
    },
    "delete_request": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "collection": { "$ref": "#/$defs/collection" },
        "record_id": { "type": "string", "minLength": 1 },
        "expected_revision": { "type": "integer", "minimum": 1 }
      },
      "required": ["request_id", "collection", "record_id", "expected_revision"],
      "additionalProperties": false
    },
    "source_upload": {
      "type": "object",
      "description": "Metadata sent with an uploaded file for ingestion; the bytes travel as the multipart body. The source is ingested under its collection's class, like any connector.",
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "collection": { "$ref": "#/$defs/collection" },
        "filename": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "pattern": "^[a-z]+/[a-zA-Z0-9.+-]+$" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "requested_class": { "type": "string", "minLength": 1 }
      },
      "required": ["request_id", "collection", "filename", "media_type", "size_bytes"],
      "additionalProperties": false
    },
    "source_upload_response": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "source_id": { "type": "string", "minLength": 1 },
        "classification": { "$ref": "https://schemas.base.internal/classification.schema.json" }
      },
      "required": ["request_id", "source_id", "classification"],
      "additionalProperties": false
    }
  }
}
