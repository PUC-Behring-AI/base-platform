# Generated by patterns, never by literal filename. base-inference's issue
# #30: a .gitignore enumerating specific generated names let a third file of
# the same category through. Every line below is a category, not an instance.

__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.venv/
venv/
.env
.DS_Store

# Worktrees belong to a machine, not to the repository.
.claude/worktrees/

# Terraform working data and state belong to a machine or a backend.
.terraform/
*.tfstate
*.tfstate.*
